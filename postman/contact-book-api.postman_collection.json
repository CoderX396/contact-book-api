  "item": [
    {
      "name": "GET /contacts → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"devuelve un arreglo con al menos 3 contactos\", () => { pm.expect(pm.response.json()).to.be.an(\"array\").with.length.at.least(3); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "contacts"
          ]
        }
      }
    },
